<Project Sdk="Microsoft.NET.Sdk">

   <!-- Everything that can be tested without a window lives here (architecture: "the
        UI project contains views and framework plumbing only"). Held to 100% line
        coverage by the CI gate. -->
   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
      <!-- Include the SDK tool dependency in the lock used by single-file CLI publishing. -->
      <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" />
      <PackageReference Include="KofTwentyTwo.AppKit" />
   </ItemGroup>

   <ItemGroup>
      <InternalsVisibleTo Include="Kof22App.Core.Tests" />
   </ItemGroup>

</Project>
