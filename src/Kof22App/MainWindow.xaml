<?xml version="1.0" encoding="utf-8"?>
<Window
   x:Class="Kof22App.MainWindow"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <Window.SystemBackdrop>
      <MicaBackdrop />
   </Window.SystemBackdrop>

   <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <MenuBar>
         <MenuBarItem Title="File">
            <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit" Click="Exit_Click" />
         </MenuBarItem>
         <MenuBarItem Title="View">
            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="System theme" GroupName="Theme" Tag="System" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light theme" GroupName="Theme" Tag="Light" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark theme" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
            <MenuFlyoutSeparator />
            <ToggleMenuFlyoutItem x:Name="SplashToggle" Text="Show splash at startup" Click="Splash_Click" />
            <ToggleMenuFlyoutItem x:Name="UpdateCheckToggle" Text="Check for updates at startup" Click="UpdateCheck_Click" />
         </MenuBarItem>
         <MenuBarItem Title="Help" AccessKey="H">
            <MenuFlyoutItem Text="View on GitHub" AccessKey="G" AutomationProperties.AutomationId="MenuGitHub" Click="GitHub_Click" />
            <MenuFlyoutItem Text="Submit an issue…" AccessKey="I" AutomationProperties.AutomationId="MenuSubmitIssue" ToolTipService.ToolTip="Report a bug or request a feature on GitHub" Click="SubmitIssue_Click" />
            <MenuFlyoutItem Text="Community support…" AccessKey="S" AutomationProperties.AutomationId="MenuCommunitySupport" ToolTipService.ToolTip="Ask a question or share tips in GitHub Discussions" Click="CommunitySupport_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="CheckForUpdatesMenuItem" Text="Check for updates" Click="CheckForUpdates_Click" />
            <MenuFlyoutItem x:Name="ActivityLogMenuItem" Text="Activity log" Click="ActivityLog_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="AboutMenuItem" Text="About Kof22 App" Click="About_Click" />
         </MenuBarItem>
      </MenuBar>

      <!-- The example feature, bound to GreetingViewModel in Kof22App.Core. Replace it with
           the app's real content. -->
      <StackPanel Grid.Row="1" Spacing="12" Padding="32" MaxWidth="560" HorizontalAlignment="Left">
         <TextBlock Text="Kof22 App" Style="{ThemeResource TitleTextBlockStyle}" />
         <TextBlock TextWrapping="Wrap" Text="A KofTwentyTwo Windows desktop application." />
         <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NameBox" Width="260" PlaceholderText="Your name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="GreetButton" Content="Greet" Command="{x:Bind ViewModel.GreetCommand}" />
         </StackPanel>
         <TextBlock x:Name="GreetingText" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
         <Button x:Name="ThrowButton" Content="Throw an unhandled exception" Click="Throw_Click" />
         <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
   </Grid>
</Window>
